# AWS Configuration
region = "us-east-1"
prefix = "genai-idp-vpc"

# Administrator email for notifications
admin_email = "your-email@example.com"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# Alternative: Use existing VPC (comment out vpc_cidr above and uncomment below)
# vpc = {
#   vpc_id                 = "vpc-12345678"
#   vpc_subnet_ids         = ["subnet-12345678", "subnet-87654321"]
#   vpc_security_group_ids = ["sg-12345678"]
# }

# Logging Configuration
log_level           = "INFO"
log_retention_days  = 7

# Data Retention
data_tracking_retention_days = 365

# Configuration File Path (optional - uses default lending package config)
# config_file_path = "../../sources/config_library/unified/lending-package-sample/config.yaml"

# Additional configuration versions (optional). Map of version_name => path to a
# YAML config file (relative to this example dir or absolute). Each is seeded as
# an editable, non-active version and appears in the UI Configuration Version
# dropdown alongside the default. Drop YAML files in examples/config-catalog (or
# anywhere) and list them here. Removing an entry stops Terraform managing it but
# does not delete the already-seeded version; delete it from the UI.
# additional_config_files = {
#   invoices = "../config-catalog/invoices.yaml"
#   receipts = "../config-catalog/receipts.yaml"
# }

# Model Configuration
classification_model_id = "us.amazon.nova-pro-v1:0"
extraction_model_id     = "us.amazon.nova-pro-v1:0"
summarization_model_id  = "us.anthropic.claude-3-7-sonnet-20250219-v1:0"
evaluation_model_id     = "anthropic.claude-3-sonnet-20240229-v1:0"

# Feature Toggles
summarization_enabled = true
enable_evaluation     = false
enable_reporting      = false

# API Configuration
#
# Feature-plugin wiring (v0.5.12): auxiliary features (MCP, Chat-with-Document,
# HITL) are now self-contained feature submodules. The legacy `var.api.*` flags
# remain the supported way to turn them on (transition path) — setting a flag
# drives the matching feature submodule under the hood (e.g.
# chat_with_document.enabled -> module.chat_with_document, enable_mcp ->
# module.mcp_integration). Each feature stays default-off unless its flag is set.
api = {
  enabled = true

  # AppSync API visibility. Set to "PRIVATE" together with the
  # `appsync-api` interface VPC endpoint (provisioned in main.tf) to
  # keep the GraphQL endpoint reachable only from inside the VPC.
  # Default "GLOBAL" exposes the API on the public internet (still
  # protected by the configured authorization mode).
  visibility = "PRIVATE"

  # Agent Analytics (requires reporting to be enabled)
  agent_analytics = {
    enabled  = false
    model_id = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
  }

  # Discovery Configuration
  discovery = {
    enabled = false
  }

  # Chat with Document Configuration
  chat_with_document = {
    enabled = false  # Forwarded to module.chat_with_document (streaming document Q&A)
    # Optional: requires knowledge_base.enabled = true
    # guardrail_id_and_version = "your-guardrail-id:1"
  }

  # Knowledge Base Configuration (optional: enables Bedrock Knowledge Base retrieval in chat)
  knowledge_base = {
    enabled = false
    # knowledge_base_arn = "arn:aws:bedrock:us-east-1:123456789012:knowledge-base/XXXXXXXXXX"
    model_id           = "us.amazon.nova-pro-v1:0"
    embedding_model_id = "amazon.titan-embed-text-v2:0"
  }

  # Process Changes Configuration
  process_changes = {
    enabled = false
  }
}

# Tags
tags = {
  Environment = "dev"
  Project     = "genai-idp-accelerator-vpc"
}

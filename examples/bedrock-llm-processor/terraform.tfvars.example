# Bedrock-LLM Processor — copy to terraform.tfvars and set the values below.
# Everything else uses the defaults in variables.tf.

region      = "us-east-1"
prefix      = "genai-idp"
admin_email = "admin@example.com" # creates the initial Web UI admin user

# ── Optional overrides (defaults shown; uncomment to change) ────────────────
# classification_model_id = "us.amazon.nova-2-lite-v1:0"
# extraction_model_id     = "us.amazon.nova-2-lite-v1:0"
# summarization_enabled   = true
# enable_evaluation       = false
# enable_reporting        = false
# enable_rule_validation  = false
# web_ui = { enabled = true }       # set enabled = false to skip CloudFront/UI
# config_file_path        = "../../sources/config_library/unified/lending-package-sample/config.yaml"
# additional_config_files = { invoices = "../config-catalog/invoices.yaml" }
# tags = { Environment = "dev" }

# ── Knowledge Base + chat (both ON by default) ──────────────────────────────
# chat_with_document and the Knowledge Base backend (OpenSearch Serverless +
# Bedrock KB, auto-wired) are enabled by default. The KB generation model is a
# cross-region inference-profile id (us./eu./apac. prefix); the embedding model
# is a plain foundation-model id. To disable or customize, set the `api` object:
# api = {
#   chat_with_document = { enabled = false } # disable per-document Q&A
#   knowledge_base = {
#     enabled            = false             # skip OpenSearch + KB (saves cost)
#     model_id           = "us.amazon.nova-pro-v1:0"
#     embedding_model_id = "amazon.titan-embed-text-v2:0"
#   }
# }
#
# Advanced toggles (agent analytics, discovery, MCP, HITL, RBAC, IdP
# federation) also live under the `api` object — see variables.tf.

# ── Build strategy (optional) ────────────────────────────────────────────────
# Defaults use AWS CodeBuild (in-cloud). Set lambda_local = true to build the
# Lambda layer zips locally with Docker/Podman/Finch. No processor container
# images are built — the engine uses zip Lambdas + shared layers. On Apple
# Silicon, x86_64 layer builds need amd64 emulation (Rosetta).
# See docs/content/deployment-guides/local-lambda-build.md.
# build = {
#   lambda_local        = false
#   lambda_architecture = "x86_64"
#   container_runtime   = "auto"
#   ui_local            = false
# }

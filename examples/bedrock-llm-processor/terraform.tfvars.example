# AWS Configuration
region = "us-east-1"
prefix = "genai-idp"

# Administrator Configuration
admin_email = "admin@example.com"

# Logging Configuration
log_level           = "INFO"
log_retention_days  = 7

# Data Retention
data_tracking_retention_days = 365

# Configuration File Path (optional - uses default lending package config)
# config_file_path = "../../sources/config_library/unified/lending-package-sample/config.yaml"

# Additional configuration versions (optional). Map of version_name => path to a
# YAML config file (relative to this example dir or absolute). Each is seeded as
# an editable, non-active version and appears in the UI Configuration Version
# dropdown alongside the default. Drop YAML files in examples/config-catalog (or
# anywhere) and list them here. Removing an entry stops Terraform managing it but
# does not delete the already-seeded version; delete it from the UI.
# additional_config_files = {
#   invoices = "../config-catalog/invoices.yaml"
#   receipts = "../config-catalog/receipts.yaml"
# }

# Optionally demonstrate the config-shape x-aws-idp-* schema flags by appending
# the overlay classes in config-overlays/round3-x-aws-idp-flags.yaml onto the
# seeded config. These flags are runtime-enforced upstream and pass through the
# seeder unchanged (no new AWS resources). Set false to seed the base config
# verbatim.
# demo_x_aws_idp_flags = true

# Model Configuration
classification_model_id = "us.amazon.nova-2-lite-v1:0"
extraction_model_id     = "us.amazon.nova-2-lite-v1:0"
summarization_model_id  = "us.amazon.nova-2-lite-v1:0"
evaluation_model_id     = "anthropic.claude-3-sonnet-20240229-v1:0"

# Feature Toggles
summarization_enabled = true
enable_evaluation     = false
enable_reporting      = false

# API Configuration
#
# Feature-plugin wiring (v0.5.12): the auxiliary features (MCP, Chat-with-Document,
# HITL) are now self-contained feature submodules. The legacy `var.api.*` flags
# below remain the supported way to turn them on (transition path) — setting them
# drives the matching feature submodule under the hood:
#   - enable_mcp                  -> module.mcp_integration
#   - chat_with_document.enabled  -> module.chat_with_document
#   - enable_hitl                 -> inline HITL feature-plugin model (complete_section_review)
# Each feature stays default-off (HITL default-on per upstream) unless its flag is set.
api = {
  enabled = true

  # v0.4.8 feature flags
  enable_agent_companion_chat = false  # Multi-agent AI chat sessions
  enable_test_studio          = false  # Automated dataset testing
  enable_fcc_dataset          = false  # Deploy sample FCC dataset (requires enable_test_studio)
  enable_w2_dataset           = false  # Deploy sample W2 dataset (requires enable_test_studio)
  enable_error_analyzer       = false  # AI-powered error diagnostics
  enable_mcp                  = false  # Forwarded to module.mcp_integration (Bedrock AgentCore Gateway, opt-in)

  # v0.5.11 — version-check resolver. Naming a public artifacts bucket
  # enables the getLatestPublishedVersion query (default-off when empty).
  # public_artifacts_bucket = "my-org-idp-published-artifacts"
  # public_artifacts_prefix = "artifacts/genai-idp"  # optional, default shown
  # public_artifacts_region = ""                     # optional, "" = deployment region

  # v0.4.16 feature flags
  enable_hitl                     = true   # Forwarded to the inline HITL feature-plugin (complete_section_review review)
  enable_capacity_planning        = false  # Capacity planning calculator
  enable_omni_ai_dataset          = false  # OmniAI OCR Benchmark dataset (requires enable_test_studio)
  enable_docplit_poly_seq_dataset = false  # DocSplit RVL-CDIP-NMP dataset (requires enable_test_studio)

  agent_analytics = {
    enabled  = false
    model_id = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
  }
  discovery = {
    enabled = true  # Creates a dedicated discovery bucket and workflow
  }
  chat_with_document = {
    enabled                  = false  # Forwarded to module.chat_with_document (streaming document Q&A)
    guardrail_id_and_version = null
    # Optional: requires knowledge_base.enabled = true
    # guardrail_id_and_version = "your-guardrail-id:1"
  }
  knowledge_base = {
    enabled            = false
    knowledge_base_arn = null  # Auto-wired by the example when enabled
    # Set enabled = true to create an OpenSearch Serverless + Bedrock Knowledge Base automatically.
    # Also set chat_with_document.enabled = true to enable document Q&A in the UI.
    model_id           = "amazon.nova-pro-v1:0"
    embedding_model_id = "amazon.titan-embed-text-v2:0"
  }
  process_changes = {
    enabled = false
  }
}

# Web UI Configuration
web_ui = {
  enabled = true
}

# Tags
tags = {
  Environment = "dev"
  Project     = "genai-idp-accelerator"
}

# v0.4.16: Rule Validation (Pattern 2 only)
enable_rule_validation = false  # Enable compliance rule validation

# v0.4.16: Lambda Hook Inference (Pattern 2 only)
# Inject custom Lambda functions into the Step Functions workflow at specific stages.
# ARNs must start with the 'GENAIIDP-' prefix.
# lambda_hook_ocr            = ""  # e.g. "GENAIIDP-my-custom-ocr-hook"
# lambda_hook_classification = ""  # e.g. "GENAIIDP-my-custom-classification-hook"
# lambda_hook_extraction     = ""  # e.g. "GENAIIDP-my-custom-extraction-hook"
# lambda_hook_assessment     = ""  # e.g. "GENAIIDP-my-custom-assessment-hook"
# lambda_hook_summarization  = ""  # e.g. "GENAIIDP-my-custom-summarization-hook"

# ---------------------------------------------------------------------------
# RBAC + External IdP federation (v0.5.12)
# ---------------------------------------------------------------------------
#
# Both features wire through the root feature-plugin path
# (var.rbac -> module.rbac, var.idp_federation -> module.idp_federation) and are
# default-OFF. The blocks below are commented out; uncomment and fill in to
# enable them. This example always provisions a Cognito user pool, which RBAC
# requires (the root `rbac_requires_cognito` check fails at plan time otherwise).
#
# RBAC: four server-side-enforced Cognito groups (Admin/Author/Reviewer/
# Viewer), a Users DynamoDB table, and a user-management Lambda. Group names are
# overridable; overriding one or more does not change the default-on behavior of
# the four roles.
#
# rbac = {
#   enabled = true
#   # Optional group-name overrides (defaults shown):
#   # group_names = {
#   #   admin    = "Admin"
#   #   author   = "Author"
#   #   reviewer = "Reviewer"
#   #   viewer   = "Viewer"
#   # }
#   # Optionally restrict which email domains the user-management Lambda may
#   # create users for (comma-separated; empty = no restriction):
#   # allowed_signup_email_domains = "example.com,corp.example.com"
# }
#
# IdP federation: federate the Cognito user pool with an external SAML or
# OIDC provider. The configured provider is ADDED to the user-pool client's
# supported identity providers without removing COGNITO, so direct sign-in keeps
# working. When rbac is also enabled, the group-mapping trigger Lambda maps
# external IdP groups/claims into the four RBAC groups at sign-in.
#
# --- SAML example ---
# idp_federation = {
#   enabled           = true
#   provider_type     = "SAML"
#   provider_name     = "CorpSAML"
#   saml_metadata_url = "https://idp.example.com/metadata.xml"
#   # Map external IdP groups -> the four RBAC groups (requires rbac.enabled):
#   group_attribute_name = "groups"
#   group_mapping = {
#     "corp-idp-admins"    = "Admin"
#     "corp-idp-authors"   = "Author"
#     "corp-idp-reviewers" = "Reviewer"
#     "corp-idp-viewers"   = "Viewer"
#   }
#   attribute_mapping = {
#     email = "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"
#   }
# }
#
# --- OIDC example ---
# The OIDC client secret is supplied by REFERENCE only (a Secrets Manager ARN or
# SSM parameter name). Never put the raw secret value in tfvars or state.
# idp_federation = {
#   enabled                = true
#   provider_type          = "OIDC"
#   provider_name          = "CorpOIDC"
#   oidc_issuer            = "https://idp.example.com"
#   oidc_client_id         = "your-oidc-client-id"
#   oidc_client_secret_ref = "arn:aws:secretsmanager:us-east-1:111122223333:secret:corp-oidc-client-secret"
#   oidc_authorize_scopes  = "openid email profile"
#   group_attribute_name   = "groups"
#   group_mapping = {
#     "corp-idp-admins" = "Admin"
#     "corp-idp-viewers" = "Viewer"
#   }
# }

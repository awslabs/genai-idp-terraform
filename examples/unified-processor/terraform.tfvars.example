# Unified Processor — dual-mode routing (BDA + Bedrock-LLM in one deployment).
# Copy to terraform.tfvars and set the values below; the rest uses variables.tf defaults.

region      = "us-east-1"
prefix      = "idp-unified"
admin_email = "admin@example.com"

# The BDA project the `bda` config version links to — pick ONE:
create_bda_project = true # let this example create + link one
# bda_project_arn  = "arn:aws:bedrock:us-east-1:111122223333:data-automation-project/abc123"

# ── Optional overrides (defaults shown; uncomment to change) ────────────────
# bda_version_name           = "bda"       # config-version that routes to BDA
# chat_with_document_enabled = true         # on by default; does NOT require a KB
# classification_model_id    = "us.amazon.nova-2-lite-v1:0"
# extraction_model_id        = "us.amazon.nova-2-lite-v1:0"
# web_ui = { enabled = true }              # set enabled = false to skip CloudFront/UI
# additional_config_files = { invoices = "../config-catalog/invoices.yaml" }
# tags = { Environment = "dev" }

# ── Knowledge Base + chat (both ON by default) ──────────────────────────────
# create_knowledge_base provisions the OpenSearch + Bedrock KB backend and
# wires it into the API (Default on); chat_with_document_enabled is also on.
# Disable to save cost:
# create_knowledge_base      = false
# chat_with_document_enabled = false
#
# The KB generation model is a cross-region inference-profile id (us./eu./apac.
# prefix); the embedding model is a plain foundation-model id.
# knowledge_base_model_id           = "us.amazon.nova-pro-v1:0"      # generation (inference profile)
# knowledge_base_embedding_model_id = "amazon.titan-embed-text-v2:0" # embeddings (foundation model)

# Build strategy (optional) — defaults to AWS CodeBuild, preserved bit-for-bit.
#
# Uncomment the block below to build artifacts locally on the deploy host
# instead of via AWS CodeBuild. This removes the CodeBuild infrastructure and
# shortens apply time:
#   - lambda_local = true  builds the Lambda layer zips locally with a
#                          container runtime (Docker / Podman / Finch).
#   - ui_local     = true  builds the web UI bundle locally with Node / npm.
#
# On Apple Silicon, x86_64 layer builds need amd64 emulation (podman machine
# with Rosetta, or Docker Desktop with Rosetta). lambda_architecture only sets
# the layers' compatible_architectures; the processor Lambda functions are
# x86_64. See docs/content/deployment-guides/local-lambda-build.md.
#
# build = {
#   lambda_local        = false     # true -> local container layer build
#   lambda_architecture = "x86_64"  # x86_64 | arm64 (layer compatible arch)
#   container_runtime   = "auto"    # auto | docker | podman | finch
#   ui_local            = false     # true -> local npm web UI build
# }

# Agent features (Web UI). All default off.
#   enable_agent_companion_chat = true  # the "Agent Companion Chat" panel
#   enable_agent_analytics      = true  # the analytics agent ("Available Agents");
#                                       # provisions a reporting S3 bucket + Glue DB
#                                       # and wires the reporting module
#   enable_mcp                  = true  # custom MCP agents (Bedrock AgentCore Gateway)
# enable_agent_companion_chat = false
# enable_agent_analytics      = false
# enable_mcp                  = false
